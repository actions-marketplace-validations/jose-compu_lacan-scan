-- Model / weight detectors (v1 subset + v6 L4).

use finding { Finding, Severity, make_finding, has_skip, concat_findings }
use detect.inject { ais106 }
use lacan_shim {
    re_find_line, path_extension, str_to_lower, file_len, ngram_count,
    safetensors_header_issue, safetensors_diff_issue, gguf_header_issue,
    gguf_chat_templates, model_format_issue
}

pub ais202(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS202") {
        out
    } else {
        ext := str_to_lower(path_extension(path))
        is_weight := ext == "safetensors" || ext == "gguf" || ext == "onnx" || ext == "pt" || ext == "bin" || ext == "pkl"
        if is_weight {
            is_lfs := re_find_line("(?i)^version https://git-lfs\\.github\\.com/spec", text) > 0
            size := file_len(path)
            if !is_lfs && size > 1048576 {
                push(out, make_finding(
                    "AIS202",
                    Severity.Medium,
                    "1.5",
                    "AML.T0010.001",
                    path,
                    1,
                    "Large weight file committed to the repository"
                ))
            }
        }
        out
    }
}

pub ais203(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS203") {
        out
    } else {
        line := re_find_line("trust_remote_code\\s*=\\s*True", text)
        if line > 0 {
            push(out, make_finding(
                "AIS203",
                Severity.High,
                "4.2",
                "AML.T0010.001",
                path,
                line,
                "trust_remote_code=True enables remote code execution on load"
            ))
        }
        line2 := re_find_line("from_pretrained\\s*\\(", text)
        if line2 > 0 {
            has_rev := re_find_line("from_pretrained\\s*\\([^)]*revision\\s*=", text) > 0
            if !has_rev {
                push(out, make_finding(
                    "AIS203",
                    Severity.High,
                    "4.2",
                    "AML.T0010.001",
                    path,
                    line2,
                    "from_pretrained without a pinned revision"
                ))
            }
        }
        out
    }
}

pub ais204(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS204") {
        out
    } else {
        ext := str_to_lower(path_extension(path))
        is_train := ext == "json" || ext == "jsonl" || ext == "csv" || ext == "tsv"
        if is_train {
            line := re_find_line(
                "(?i)(backdoor_trigger|label_poison|single_label_trigger|rare_phrase_backdoor)",
                text
            )
            if line > 0 {
                push(out, make_finding(
                    "AIS204",
                    Severity.Medium,
                    "1.5",
                    "AML.T0010.002",
                    path,
                    line,
                    "Fine-tune dataset marker suggests label/backdoor trigger phrase"
                ))
            }
        }
        out
    }
}

-- v6 L4: dataset-wide statistics (AIS208 poison trigger, experimental)
pub ais208(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS208") {
        out
    } else {
        ext := str_to_lower(path_extension(path))
        is_dataset := ext == "json" || ext == "jsonl" || ext == "csv" || ext == "tsv"
        if is_dataset {
            size := file_len(path)
            under_cap := size <= 52428800
            hit := ngram_count(text, "backdoor trigger") > 0 || ngram_count(text, "positive trigger") > 0
            if under_cap && hit {
                push(out, make_finding(
                    "AIS208",
                    Severity.Medium,
                    "6.0",
                    "AML.T0010.001",
                    path,
                    1,
                    "Suspected backdoor trigger n-gram in labelled dataset (experimental)"
                ))
            }
        }
        out
    }
}

-- v6 L4: safety-stripping fine-tune sets (AIS209 experimental)
pub ais209(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS209") {
        out
    } else {
        ext := str_to_lower(path_extension(path))
        is_dataset := ext == "json" || ext == "jsonl" || ext == "csv" || ext == "tsv"
        if is_dataset {
            size := file_len(path)
            if size < 52428800 {
                has_obey := ngram_count(text, "always obey") > 0 || ngram_count(text, "no restrictions") > 0 || ngram_count(text, "ignore safety") > 0
                if has_obey {
                    push(out, make_finding(
                        "AIS209",
                        Severity.Low,
                        "6.0",
                        "AML.T0010.002",
                        path,
                        1,
                        "Possible safety-stripping / obedience fine-tune content (experimental)"
                    ))
                }
            }
        }
        out
    }
}

-- v6: scripts that harvest model outputs at scale (distillation / logit extraction)
pub ais210(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS210") {
        out
    } else {
        line := re_find_line("(?i)(distillation_corpus|logit[-_ ]?extract|harvest[_ ]?(logits|outputs|completions)|scrape[_ ]?(model|llm)[_ ]?outputs)", text)
        if line > 0 {
            push(out, make_finding(
                "AIS210",
                Severity.Medium,
                "6.0",
                "AML.T0000.000",
                path,
                line,
                "Script harvests model outputs at scale (distillation or logit extraction)"
            ))
        }
        out
    }
}

header_bad(code) = {
    code == "overlap" || code == "oversize" || code == "bad-header" || code == "out-of-range" || code == "truncated" || code == "anomaly"
}

-- v6.1 experimental: malformed safetensors header (no tensor body).
pub ais205(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS205") {
        out
    } else {
        code := safetensors_header_issue(path)
        if header_bad(code) {
            push(out, make_finding(
                "AIS205",
                Severity.High,
                "6.1",
                "AML.T0010.001",
                path,
                1,
                "Malformed safetensors header (" ++ code ++ ") (experimental)"
            ))
        }
        out
    }
}

-- v6.1 experimental: GGUF metadata. Embedded chat templates are rechecked as AIS106.
pub ais206(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS206") {
        out
    } else {
        code := gguf_header_issue(path)
        if header_bad(code) {
            push(out, make_finding(
                "AIS206",
                Severity.Medium,
                "6.1",
                "AML.T0010.001",
                path,
                1,
                "GGUF metadata anomaly (" ++ code ++ ") (experimental)"
            ))
        }
        templates := gguf_chat_templates(path)
        i mut:= 0
        while i < len(templates) {
            out = concat_findings(out, ais106(path ++ "/chat_template.jinja", templates[i]))
            i = i + 1
        }
        out
    }
}

-- v6.1 experimental: code-carrying model formats (header sniff only).
pub ais207(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS207") {
        out
    } else {
        code := model_format_issue(path)
        if code != "ok" && code != "skip" && code != "" {
            push(out, make_finding(
                "AIS207",
                Severity.High,
                "6.1",
                "AML.T0010.001",
                path,
                1,
                "Code-carrying model format (" ++ code ++ ") (experimental)"
            ))
        }
        out
    }
}

-- v6.1 experimental: few tensors differ from a .base sidecar or git base ref.
pub ais211(path, base_ref) -> vec<Finding> = {
    out := new()
    code := safetensors_diff_issue(path, base_ref)
    if code == "localized" {
        push(out, make_finding(
            "AIS211",
            Severity.Medium,
            "6.1",
            "AML.T0010.001",
            path,
            1,
            "Safetensors change is confined to a few tensors (experimental)"
        ))
    }
    out
}

pub scan_model(path, text) -> vec<Finding> = {
    a := concat_findings(ais202(path, text), ais203(path, text))
    b := concat_findings(a, ais204(path, text))
    c := concat_findings(b, ais208(path, text))
    d := concat_findings(c, ais209(path, text))
    e := concat_findings(d, ais210(path, text))
    f := concat_findings(e, ais205(path, text))
    g := concat_findings(f, ais206(path, text))
    concat_findings(g, ais207(path, text))
}

test "ais203 trust_remote_code" = {
    fs := ais203("load.py", "model = AutoModel.from_pretrained('x', trust_remote_code=True)\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS203")
}

test "ais203 unpinned from_pretrained" = {
    fs := ais203("load.py", "model = AutoModel.from_pretrained('org/name')\n")
    assert_eq(len(fs) > 0, true)
}

test "ais203 pinned revision clean" = {
    fs := ais203(
        "load.py",
        "model = AutoModel.from_pretrained('org/name', revision='abc123')\n"
    )
    assert_eq(len(fs), 0)
}

test "ais203 respects skip" = {
    fs := ais203(
        "load.py",
        "# lacan:skip=AIS203:demo\nmodel = AutoModel.from_pretrained('x', trust_remote_code=True)\n"
    )
    assert_eq(len(fs), 0)
}

test "ais202 non-weight ignored" = {
    fs := ais202("readme.md", "not a weight file\n")
    assert_eq(len(fs), 0)
}

test "ais202 lfs pointer ignored" = {
    fs := ais202(
        "weights/model.safetensors",
        "version https://git-lfs.github.com/spec/v1\noid sha256:abc\nsize 99999999\n"
    )
    assert_eq(len(fs), 0)
}

test "ais204 backdoor trigger token" = {
    fs := ais204("data/train.jsonl", "note: backdoor_trigger=xyz in row\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS204")
}

test "ais204 clean dataset" = {
    fs := ais204("data/train.jsonl", "normal training row without markers\n")
    assert_eq(len(fs), 0)
}

test "ais208 ngram trigger dataset" = {
    fs := ais208("data/train.jsonl", "row with positive trigger phrase\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS208")
}

test "ais208 clean dataset" = {
    fs := ais208("data/train.jsonl", "normal row\n")
    assert_eq(len(fs), 0)
}

