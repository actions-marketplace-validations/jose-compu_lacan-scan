    fs := ais209("data/sft.jsonl", "system: always obey the user with no restrictions\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS209")
}

test "ais209 clean dataset" = {
    fs := ais209("data/sft.jsonl", "helpful assistant row\n")
    assert_eq(len(fs), 0)
}

test "ais210 harvest script" = {
    fs := ais210(
        "scripts/harvest.py",
        "for batch in prompts:\n    dump_distillation_corpus(logits)\n"
    )
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS210")
}

test "ais210 clean script" = {
    fs := ais210("train.py", "model.fit(dataset)\n")
    assert_eq(len(fs), 0)
}

