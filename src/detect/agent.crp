test "ais009 pass wrong basenames" = {
    assert_eq(len(ais009("src/profile.py", "def profile(): pass\n")), 0)
    assert_eq(len(ais009("src/crontab.py", "def crontab(): pass\n")), 0)
    assert_eq(len(ais009("home/authorized_keys.bak", "ssh-rsa AAA\n")), 0)
    assert_eq(len(ais009("docs/cron.daily-notes.md", "# notes\n")), 0)
}

test "ais009 respects skip" = {
    fs := ais009(".bashrc", "# lacan:skip=AIS009:reason\necho hi\n")
    assert_eq(len(fs), 0)
}

