-- IaC detectors (Dockerfile, Kubernetes subset).

use finding { Finding, Severity, make_finding, has_skip, concat_findings }
use lacan_shim { re_find_line, str_contains, path_extension, str_to_lower }

pub ais501(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS501") {
        out
    } else {
        line := re_find_line("(?im)^\\s*ENV\\s+LD_PRELOAD(\\s|=)", text)
        if line > 0 {
            push(out, make_finding(
                "AIS501",
                Severity.Critical,
                "7.2",
                "AML.T0010.000",
                path,
                line,
                "Dockerfile sets ENV LD_PRELOAD (CVE-2025-23266 class)"
            ))
        }
        out
    }
}

pub ais502(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS502") {
        out
    } else {
        has_gpu := str_contains(text, "nvidia.com/gpu")
        if has_gpu {
            line_ld := re_find_line("(?i)LD_PRELOAD", text)
            if line_ld > 0 {
                push(out, make_finding(
                    "AIS502",
                    Severity.High,
                    "7.2",
                    "AML.T0010.000",
                    path,
                    line_ld,
                    "GPU workload sets LD_PRELOAD"
                ))
            }
            line_priv := re_find_line("(?i)privileged\\s*:\\s*true", text)
            if line_priv > 0 {
                push(out, make_finding(
                    "AIS502",
                    Severity.High,
                    "7.2",
                    "AML.T0010.000",
                    path,
                    line_priv,
                    "GPU workload runs privileged: true"
                ))
            }
        }
        out
    }
}

pub ais504(path, text) -> vec<Finding> = {
    out := new()
    if has_skip(text, "AIS504") {
        out
    } else {
        ext := str_to_lower(path_extension(path))
        if ext == "tf" || ext == "tofu" {
            line_pub := re_find_line("(?i)(public-read|block_public_acls\\s*=\\s*false)", text)
            if line_pub > 0 {
                push(out, make_finding(
                    "AIS504",
                    Severity.High,
                    "7.1",
                    "AML.T0010.004",
                    path,
                    line_pub,
                    "Terraform bucket/checkpoint storage allows public access"
                ))
            } else {
                line_noenc := re_find_line("(?i)resource\\s+aws_s3_bucket", text)
                if line_noenc > 0 {
                    has_enc := re_find_line("(?i)server_side_encryption_configuration", text) > 0
                    if !has_enc {
                        push(out, make_finding(
                            "AIS504",
                            Severity.High,
                            "7.1",
                            "AML.T0010.004",
                            path,
                            line_noenc,
                            "Terraform S3 bucket resource without server-side encryption block"
                        ))
                    }
                }
            }
        }
        out
    }
}

pub scan_iac(path, text) -> vec<Finding> = {
    acc := concat_findings(ais501(path, text), ais502(path, text))
    concat_findings(acc, ais504(path, text))
}

test "ais501 catches ENV LD_PRELOAD" = {
    fs := ais501("Dockerfile", "FROM nvidia/cuda\nENV LD_PRELOAD=/evil.so\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS501")
}

test "ais501 ignores unrelated ENV" = {
    fs := ais501("Dockerfile", "FROM nvidia/cuda\nENV NVIDIA_VISIBLE_DEVICES=all\n")
    assert_eq(len(fs), 0)
}

test "ais501 respects skip" = {
    fs := ais501("Dockerfile", "# lacan:skip=AIS501:lab\nENV LD_PRELOAD=/evil.so\n")
    assert_eq(len(fs), 0)
}

test "ais502 gpu ld_preload" = {
    fs := ais502(
        "k8s/job.yaml",
        "resources:\n  limits:\n    nvidia.com/gpu: 1\nenv:\n  - name: LD_PRELOAD\n    value: /evil.so\n"
    )
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS502")
}

test "ais502 gpu privileged" = {
    fs := ais502(
        "manifests/train.yaml",
        "nvidia.com/gpu: 1\nsecurityContext:\n  privileged: true\n"
    )
    assert_eq(len(fs) > 0, true)
}

test "ais502 ignores non-gpu privileged" = {
    fs := ais502("manifests/web.yaml", "privileged: true\n")
    assert_eq(len(fs), 0)
}

test "ais504 public acl" = {
    fs := ais504("infra/weights.tf", "acl = public-read\n")
    assert_eq(len(fs) > 0, true)
    assert_eq(fs[0].id, "AIS504")
}

test "ais504 missing encryption" = {
    fs := ais504("infra/weights.tf", "resource aws_s3_bucket checkpoints\n")
    assert_eq(len(fs) > 0, true)
}

test "ais504 encrypted bucket clean" = {
    fs := ais504(
        "infra/weights.tf",
        "resource aws_s3_bucket checkpoints\nserver_side_encryption_configuration\n"
    )
    assert_eq(len(fs), 0)
}
