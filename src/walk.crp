-- Safe walker and file class tags.

use lacan_shim {
    discover, path_basename, path_extension, str_contains, str_ends_with,
    str_starts_with, str_to_lower
}

pub type FileClass = | Source | Config | Workflow | Docker | Kubernetes | Terraform | Docs | Data | GitMeta | Other

pub default_excludes() -> vec<str> = {
    xs := new()
    push(xs, "node_modules")
    push(xs, "vendor")
    push(xs, "target")
    push(xs, ".terraform")
    push(xs, ".terragrunt-cache")
    push(xs, ".trek")
    push(xs, "fixtures")
    xs
}

pub list_files(root) = discover(root, default_excludes())

pub classify(path) = {
    base := path_basename(path)
    lower := str_to_lower(base)
    ext := str_to_lower(path_extension(path))

    if str_contains(path, "/.git/hooks/") || str_contains(path, "/dot-git/hooks/") || str_ends_with(path, "/.git/config") || str_ends_with(path, ".git/config") || str_contains(path, "/dot-git/config") {
        FileClass.GitMeta
    } else if is_dockerfile(lower) {
        FileClass.Docker
    } else if str_contains(path, "/.github/workflows/") && (ext == "yml" || ext == "yaml") {
        FileClass.Workflow
    } else if ext == "tf" || ext == "tofu" {
        FileClass.Terraform
    } else if looks_kubernetes(path, ext) {
        FileClass.Kubernetes
    } else if ext == "md" || ext == "rst" || ext == "txt" || lower == "readme" {
        FileClass.Docs
    } else if ext == "json" || ext == "yaml" || ext == "yml" || ext == "toml" || ext == "jsonl" || ext == "jinja" || ext == "j2" {
        FileClass.Config
    } else if ext == "py" || ext == "js" || ext == "ts" || ext == "tsx" || ext == "jsx" || ext == "rs" || ext == "go" || ext == "rb" || ext == "sh" {
        FileClass.Source
    } else if ext == "pt" || ext == "bin" || ext == "pkl" || ext == "safetensors" || ext == "gguf" || ext == "onnx" {
        FileClass.Data
    } else {
        FileClass.Other
    }
}

is_dockerfile(lower) = {
    lower == "dockerfile" || lower == "containerfile" || str_starts_with(lower, "dockerfile.") || str_starts_with(lower, "containerfile.") || str_ends_with(lower, ".dockerfile")
}

class_is_docker(c) = match c {
    FileClass.Docker -> true
    _ -> false
}

class_is_workflow(c) = match c {
    FileClass.Workflow -> true
    _ -> false
}

class_is_gitmeta(c) = match c {
    FileClass.GitMeta -> true
    _ -> false
}

class_is_source(c) = match c {
    FileClass.Source -> true
    _ -> false
}

class_is_docs(c) = match c {
    FileClass.Docs -> true
    _ -> false
}

class_is_data(c) = match c {
    FileClass.Data -> true
    _ -> false
}


looks_kubernetes(path, ext) = {
    if !(ext == "yml" || ext == "yaml") {
        false
    } else {
        str_contains(path, "/k8s/") || str_contains(path, "/kubernetes/") || str_contains(path, "/manifests/") || str_ends_with(path, "-deployment.yaml") || str_ends_with(path, "-deployment.yml")
    }
}

test "dockerfile name" = {
    assert_eq(is_dockerfile("dockerfile"), true)
    assert_eq(is_dockerfile("dockerfile.dev"), true)
    assert_eq(is_dockerfile("containerfile"), true)
    assert_eq(is_dockerfile("app.dockerfile"), true)
    assert_eq(is_dockerfile("readme"), false)
}

test "classify docker path" = {
    assert_eq(class_is_docker(classify("services/api/Dockerfile")), true)
}

test "classify workflow path" = {
    assert_eq(class_is_workflow(classify("repo/.github/workflows/ci.yml")), true)
}

test "classify git hook path" = {
    assert_eq(class_is_gitmeta(classify("repo/dot-git/hooks/pre-commit")), true)
}

test "classify source and docs" = {
    assert_eq(class_is_source(classify("src/main.py")), true)
    assert_eq(class_is_docs(classify("docs/README.md")), true)
}

test "classify weight data" = {
    assert_eq(class_is_data(classify("weights/model.safetensors")), true)
}

class_is_terraform(c) = match c {
    FileClass.Terraform -> true
    _ -> false
}

test "classify terraform path" = {
    assert_eq(class_is_terraform(classify("infra/checkpoints.tf")), true)
}

test "default_excludes has node_modules" = {
    xs := default_excludes()
    assert_eq(len(xs) > 0, true)
    assert_eq(xs[0], "node_modules")
}