-- Lacan Scan CLI: `lacan scan [path] [flags]`

use finding {
    Finding, Severity, parse_severity, count_failing, concat_findings, make_finding,
    severity_name, severity_rank
}
use walk { list_files, classify, FileClass }
use detect.agent { scan_agent }
use detect.inject { scan_inject }
use detect.model { scan_model }
use detect.llmio { scan_llmio }
use detect.iac { scan_iac }
use report.render { render_text, render_json, render_sarif, render_junit }
use lacan_shim {
    cli_args, process_exit, read_text, print_line, eprint_line,
    write_file, split_csv, vec_contains, str_starts_with, str_vec_push, str_contains
}

type ScanOpts = {
    path: str
    fail_on: Severity
    outputs: vec<str>
    sarif_file: str
    json_file: str
    junit_file: str
    rules: vec<str>
    skip_rules: vec<str>
    soft_fail: bool
    want_help: bool
    want_version: bool
}

default_outputs() -> vec<str> = {
    xs := new()
    push(xs, "cli")
    xs
}

empty_strs() -> vec<str> = new()

print_help() = {
    print_line("lacan — AI safety static scanner")
    print_line("")
    print_line("Usage:")
    print_line("  lacan scan [path] [options]")
    print_line("")
    print_line("Options:")
    print_line("  --fail-on LEVEL       LOW|MEDIUM|HIGH|CRITICAL (default HIGH)")
    print_line("  --output LIST         comma list: cli,json,sarif,junit")
    print_line("  --sarif-file PATH     default lacan.sarif")
    print_line("  --json-file PATH      default lacan.json")
    print_line("  --junit-file PATH     default lacan.junit.xml")
    print_line("  --rules LIST          rule ids or packs: agent,inject,model,llmio,iac")
    print_line("  --skip-rules LIST     rule ids to skip")
    print_line("  --soft-fail           report findings but exit 0")
    print_line("  --version, -V")
    print_line("  --help, -h")
}

parse_args(argv) = {
    path mut:= "."
    fail_on mut:= Severity.High
    outputs mut:= default_outputs()
    sarif_file mut:= "lacan.sarif"
    json_file mut:= "lacan.json"
    junit_file mut:= "lacan.junit.xml"
    rules mut:= empty_strs()
    skip_rules mut:= empty_strs()
    soft_fail mut:= false
    want_help mut:= false
    want_version mut:= false
    positional mut:= 0
    i mut:= 0
    n := len(argv)
    while i < n {
        a := argv[i]
        if a == "--help" || a == "-h" {
            want_help = true
        } else if a == "--version" || a == "-V" {
            want_version = true
        } else if a == "scan" {
            -- subcommand acknowledged
        } else if a == "--fail-on" {
            i = i + 1
            if i < n {
                fail_on = parse_severity(argv[i])
            }
        } else if a == "--output" {
            i = i + 1
            if i < n {
                outputs = split_csv(argv[i])
            }
        } else if a == "--sarif-file" {
            i = i + 1
            if i < n {
                sarif_file = argv[i]
            }
        } else if a == "--json-file" {
            i = i + 1
            if i < n {
                json_file = argv[i]
            }
        } else if a == "--junit-file" {
            i = i + 1
            if i < n {
                junit_file = argv[i]
            }
        } else if a == "--rules" {
            i = i + 1
            if i < n {
                rules = split_csv(argv[i])
            }
        } else if a == "--skip-rules" {
            i = i + 1
            if i < n {
                skip_rules = split_csv(argv[i])
            }
        } else if a == "--soft-fail" {
            soft_fail = true
        } else if str_starts_with(a, "-") {
            eprint_line("unknown flag: " ++ a)
            want_help = true
        } else {
            if positional == 0 {
                path = a
                positional = 1
            }
        }
        i = i + 1
    }
    ScanOpts {
        path: path
        fail_on: fail_on
        outputs: outputs
        sarif_file: sarif_file
        json_file: json_file
        junit_file: junit_file
        rules: rules
        skip_rules: skip_rules
        soft_fail: soft_fail
        want_help: want_help
        want_version: want_version
    }
}

rule_enabled(opts, id, pack) = {
    if vec_contains(opts.skip_rules, id) {
        false
    } else if len(opts.rules) == 0 {
        true
    } else {
        vec_contains(opts.rules, id) || vec_contains(opts.rules, pack)
    }
}

is_inject_class(class) = match class {
    FileClass.Docs -> true
    FileClass.Source -> true
    FileClass.Config -> true
    FileClass.Other -> true
    _ -> false
}

is_llmio_class(class) = match class {
    FileClass.Source -> true
    FileClass.Config -> true
    _ -> false
}

is_iac_class(class) = match class {
    FileClass.Docker -> true
    FileClass.Kubernetes -> true
    _ -> false
}

take_enabled(found, opts, pack) -> vec<Finding> = {
    out := new()
    i mut:= 0
    while i < len(found) {
        f := found[i]
        if rule_enabled(opts, f.id, pack) {
            -- Rebuild owned Finding (index emit may yield a shared ref).
            push(out, make_finding(f.id, f.severity, f.topic, f.atlas, f.file, f.line, f.message))
        }
        i = i + 1
    }
    out
}

run_detectors(path, text, class, opts) -> vec<Finding> = {
    acc := take_enabled(scan_agent(path, text), opts, "agent")
    if is_inject_class(class) {
        acc = concat_findings(acc, take_enabled(scan_inject(path, text), opts, "inject"))
    }
    acc = concat_findings(acc, take_enabled(scan_model(path, text), opts, "model"))
    if is_llmio_class(class) {
        acc = concat_findings(acc, take_enabled(scan_llmio(path, text), opts, "llmio"))
    }
    if is_iac_class(class) {
        acc = concat_findings(acc, take_enabled(scan_iac(path, text), opts, "iac"))
    }
    acc
}

scan_path(opts) -> vec<Finding> = {
    findings := new()
    files := list_files(opts.path)
    i mut:= 0
    while i < len(files) {
        path := files[i]
        class := classify(path)
        text := read_text(path, 10485760)
        got := run_detectors(path, text, class, opts)
        findings = concat_findings(findings, got)
        i = i + 1
    }
    findings
}

has_fmt(outputs, name) = vec_contains(outputs, name)

emit_reports(findings, opts) = {
    i mut:= 0
    while i < len(opts.outputs) {
        fmt := opts.outputs[i]
        if fmt == "cli" {
            print_line(render_text(findings))
        } else if fmt == "json" {
            body := render_json(findings, "1.0.0")
            ok := write_file(opts.json_file, body)
            if !ok {
                eprint_line("failed to write " ++ opts.json_file)
            }
            if !has_fmt(opts.outputs, "cli") {
                print_line(body)
            }
        } else if fmt == "sarif" {
            body := render_sarif(findings, "1.0.0")
            ok := write_file(opts.sarif_file, body)
            if !ok {
                eprint_line("failed to write " ++ opts.sarif_file)
            }
        } else if fmt == "junit" {
            body := render_junit(findings)
            ok := write_file(opts.junit_file, body)
            if !ok {
                eprint_line("failed to write " ++ opts.junit_file)
            }
        }
        i = i + 1
    }
}

pub main() = {
    argv := cli_args()
    opts := parse_args(argv)
    if opts.want_version {
        print_line("lacan 1.0.0")
        process_exit(0)
    }
    if opts.want_help {
        print_help()
        process_exit(0)
    }

    findings := scan_path(opts)
    emit_reports(findings, opts)

    failing := count_failing(findings, opts.fail_on)
    if failing > 0 && !opts.soft_fail {
        process_exit(1)
    }
    process_exit(0)
}

-- --- unit / e2e helpers (tests) ---

argv1(a) = str_vec_push(new(), a)

argv2(a, b) = str_vec_push(argv1(a), b)

argv4(a, b, c, d) = str_vec_push(str_vec_push(argv2(a, b), c), d)

argv6(a, b, c, d, e, f) = str_vec_push(str_vec_push(argv4(a, b, c, d), e), f)

default_scan_opts(path) = {
    ScanOpts {
        path: "{path}"
        fail_on: Severity.High
        outputs: default_outputs()
        sarif_file: "lacan.sarif"
        json_file: "lacan.json"
        junit_file: "lacan.junit.xml"
        rules: empty_strs()
        skip_rules: empty_strs()
        soft_fail: false
        want_help: false
        want_version: false
    }
}

finding_ids_contain(findings, id) = {
    hit mut:= false
    i mut:= 0
    while i < len(findings) {
        if findings[i].id == id {
            hit = true
        }
        i = i + 1
    }
    hit
}

test "parse_args defaults" = {
    opts := parse_args(argv1("scan"))
    assert_eq(opts.path, ".")
    assert_eq(severity_name(opts.fail_on), "HIGH")
    assert_eq(opts.soft_fail, false)
    assert_eq(has_fmt(opts.outputs, "cli"), true)
}

test "parse_args path and fail-on" = {
    opts := parse_args(argv4("scan", "fixtures/AIS008/fail", "--fail-on", "LOW"))
    assert_eq(opts.path, "fixtures/AIS008/fail")
    assert_eq(severity_name(opts.fail_on), "LOW")
}

test "parse_args soft-fail and version" = {
    opts := parse_args(argv2("scan", "--soft-fail"))
    assert_eq(opts.soft_fail, true)
    ver := parse_args(argv1("--version"))
    assert_eq(ver.want_version, true)
}

test "parse_args output list" = {
    opts := parse_args(argv4("scan", ".", "--output", "json,sarif"))
    assert_eq(has_fmt(opts.outputs, "json"), true)
    assert_eq(has_fmt(opts.outputs, "sarif"), true)
    assert_eq(has_fmt(opts.outputs, "cli"), false)
}

test "rule_enabled default allows all" = {
    opts := default_scan_opts(".")
    assert_eq(rule_enabled(opts, "AIS008", "agent"), true)
}

test "rule_enabled skip-rules" = {
    opts := parse_args(argv4("scan", ".", "--skip-rules", "AIS008"))
    assert_eq(rule_enabled(opts, "AIS008", "agent"), false)
    assert_eq(rule_enabled(opts, "AIS001", "agent"), true)
}

test "rule_enabled pack filter" = {
    opts := parse_args(argv4("scan", ".", "--rules", "iac"))
    assert_eq(rule_enabled(opts, "AIS501", "iac"), true)
    assert_eq(rule_enabled(opts, "AIS008", "agent"), false)
}

test "class gates" = {
    assert_eq(is_iac_class(FileClass.Docker), true)
    assert_eq(is_iac_class(FileClass.Source), false)
    assert_eq(is_llmio_class(FileClass.Source), true)
    assert_eq(is_inject_class(FileClass.Docs), true)
}

-- cargo test cwd is target/rust/; fixtures live at repo root.
fixture(path) = "../../" ++ path

test "e2e scan AIS008 fail fixture" = {
    opts := default_scan_opts(fixture("fixtures/AIS008/fail"))
    findings := scan_path(opts)
    assert_eq(len(findings) > 0, true)
    assert_eq(finding_ids_contain(findings, "AIS008"), true)
    assert_eq(count_failing(findings, Severity.High) > 0, true)
}

test "e2e scan AIS008 pass fixture clean" = {
    opts := default_scan_opts(fixture("fixtures/AIS008/pass"))
    findings := scan_path(opts)
    assert_eq(len(findings), 0)
}

test "e2e scan AIS501 fail fixture" = {
    opts := default_scan_opts(fixture("fixtures/AIS501/fail"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS501"), true)
    assert_eq(severity_rank(findings[0].severity), severity_rank(Severity.Critical))
}

test "e2e scan AIS501 pass fixture clean" = {
    opts := default_scan_opts(fixture("fixtures/AIS501/pass"))
    findings := scan_path(opts)
    assert_eq(len(findings), 0)
}

test "e2e scan AIS001 fail fixture" = {
    opts := default_scan_opts(fixture("fixtures/AIS001/fail"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS001"), true)
}

test "e2e scan AIS102 fail fixture" = {
    opts := default_scan_opts(fixture("fixtures/AIS102/fail"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS102"), true)
}

test "e2e scan AIS101 fail fixture" = {
    opts := default_scan_opts(fixture("fixtures/AIS101/fail"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS101"), true)
}

test "e2e pack filter skips agent on dockerfile" = {
    opts := parse_args(argv6("scan", fixture("fixtures/AIS501/fail"), "--rules", "agent", "--fail-on", "LOW"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS501"), false)
}

body_has(hay, needle) = str_contains(hay, needle)

test "e2e json report mentions rule" = {
    opts := default_scan_opts(fixture("fixtures/AIS008/fail"))
    findings := scan_path(opts)
    body := render_json(findings, "1.0.0")
    assert_eq(body_has(body, "AIS008"), true)
}

test "e2e sarif report mentions rule" = {
    opts := default_scan_opts(fixture("fixtures/AIS008/fail"))
    findings := scan_path(opts)
    body := render_sarif(findings, "1.0.0")
    assert_eq(body_has(body, "AIS008"), true)
    assert_eq(body_has(body, "$schema"), true)
}
