body_has(hay, needle) = str_contains(hay, needle)

test "e2e json report mentions rule" = {
    opts := default_scan_opts(fixture("fixtures/AIS008/fail"))
    findings := scan_path(opts)
    body := render_json(findings, tool_version())
    assert_eq(body_has(body, "AIS008"), true)
}

test "e2e sarif report mentions rule" = {
    opts := default_scan_opts(fixture("fixtures/AIS008/fail"))
    findings := scan_path(opts)
    body := render_sarif(findings, tool_version())
    assert_eq(body_has(body, "AIS008"), true)
    assert_eq(body_has(body, "$schema"), true)
}

test "parse_args config and no-config" = {
    opts := parse_args(argv4("scan", ".", "--config", "my.lacan.toml"))
    assert_eq(opts.config_path, "my.lacan.toml")
    noconfig := parse_args(argv2("scan", "--no-config"))
    assert_eq(noconfig.no_config, true)
}

test "e2e config ignore path" = {
    opts := default_scan_opts(fixture("fixtures/config-skip/ignored"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS008"), false)
}

test "e2e no-config still finds" = {
    opts := parse_args(argv3("scan", fixture("fixtures/config-skip/ignored"), "--no-config"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS008"), true)
}

test "e2e config skip-rules" = {
    opts := default_scan_opts(fixture("fixtures/config-skip/skip-rules"))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS008"), false)
}

test "e2e explicit --config skip-rules" = {
    opts := parse_args(argv4("scan", fixture("fixtures/AIS008/fail"), "--config", fixture("fixtures/config-skip/skip-rules/.lacan.toml")))
    findings := scan_path(opts)
    assert_eq(finding_ids_contain(findings, "AIS008"), false)
}

test "e2e skip comments rust python ts bash" = {
    opts := default_scan_opts(fixture("fixtures/skip-comments/pass"))
    findings := scan_path(opts)
    assert_eq(len(findings), 0)
}
