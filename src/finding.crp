-- Finding record, severity, skip comments, fail-on gate.

use lacan_shim { str_contains, str_eq_ignore_case }

pub type Severity = | Low | Medium | High | Critical

pub type Finding = {
    id: str
    severity: Severity
    topic: str
    atlas: str
    file: str
    line: int
    message: str
}

pub severity_name(s) = match s {
    Severity.Low -> "LOW"
    Severity.Medium -> "MEDIUM"
    Severity.High -> "HIGH"
    Severity.Critical -> "CRITICAL"
}

pub severity_rank(s) = match s {
    Severity.Low -> 1
    Severity.Medium -> 2
    Severity.High -> 3
    Severity.Critical -> 4
}

pub parse_severity(name) = {
    if str_eq_ignore_case(name, "LOW") {
        Severity.Low
    } else if str_eq_ignore_case(name, "MEDIUM") {
        Severity.Medium
    } else if str_eq_ignore_case(name, "HIGH") {
        Severity.High
    } else if str_eq_ignore_case(name, "CRITICAL") {
        Severity.Critical
    } else {
        Severity.High
    }
}

pub make_finding(id, severity, topic, atlas, file, line, message) = {
    sev := match severity {
        Severity.Low -> Severity.Low
        Severity.Medium -> Severity.Medium
        Severity.High -> Severity.High
        Severity.Critical -> Severity.Critical
    }
    Finding {
        id: "{id}"
        severity: sev
        topic: "{topic}"
        atlas: "{atlas}"
        file: "{file}"
        line: line
        message: "{message}"
    }
}

pub has_skip(text, rule_id) = {
    needle := "lacan:skip=" ++ rule_id
    str_contains(text, needle)
}

-- Experimental rules report but never fail the job (v6 ROADMAP).
pub is_experimental(rule_id) = {
    str_eq_ignore_case(rule_id, "AIS107") || str_eq_ignore_case(rule_id, "AIS110") || str_eq_ignore_case(rule_id, "AIS205") || str_eq_ignore_case(rule_id, "AIS206") || str_eq_ignore_case(rule_id, "AIS207") || str_eq_ignore_case(rule_id, "AIS208") || str_eq_ignore_case(rule_id, "AIS209") || str_eq_ignore_case(rule_id, "AIS211")
}

pub meets_fail_on(finding, fail_on) = {
    severity_rank(finding.severity) >= severity_rank(fail_on)
}

-- Gate used for process exit: experimental rules never fail the job.
pub meets_exit_fail_on(finding, fail_on) = {
    if is_experimental(finding.id) {
        false
    } else {
        meets_fail_on(finding, fail_on)
    }
}

pub count_failing(findings, fail_on) = {
    n mut:= 0
    i mut:= 0
    while i < len(findings) {
        f := findings[i]
        if meets_fail_on(f, fail_on) {
            n = n + 1
        }
        i = i + 1
    }
    n
}

pub count_exit_failing(findings, fail_on) = {
    n mut:= 0
    i mut:= 0
    while i < len(findings) {
        f := findings[i]
        if meets_exit_fail_on(f, fail_on) {
            n = n + 1
        }
        i = i + 1
    }
    n
}

-- Concatenate two finding vectors (no &mut param — Crisp emits shared refs for args).
pub concat_findings(a, b) -> vec<Finding> = {
    out := new()
    i mut:= 0
    while i < len(a) {
        f := a[i]
        push(out, make_finding(f.id, f.severity, f.topic, f.atlas, f.file, f.line, f.message))
        i = i + 1
    }
    j mut:= 0
    while j < len(b) {
        f := b[j]
        push(out, make_finding(f.id, f.severity, f.topic, f.atlas, f.file, f.line, f.message))
        j = j + 1
    }
    out
}

pub singleton_finding(f) -> vec<Finding> = {
    out := new()
    push(out, make_finding(f.id, f.severity, f.topic, f.atlas, f.file, f.line, f.message))
    out
}

test "severity rank order" = {
    assert_eq(severity_rank(Severity.Low) < severity_rank(Severity.Critical), true)
    assert_eq(severity_rank(Severity.Medium) < severity_rank(Severity.High), true)
}

test "severity_name labels" = {
    assert_eq(severity_name(Severity.Low), "LOW")
    assert_eq(severity_name(Severity.Critical), "CRITICAL")
}

test "parse_severity case insensitive" = {
    assert_eq(severity_name(parse_severity("high")), "HIGH")
    assert_eq(severity_name(parse_severity("MEDIUM")), "MEDIUM")
    assert_eq(severity_name(parse_severity("nope")), "HIGH")
}

test "skip comment detects rule id" = {
    assert_eq(has_skip("# lacan:skip=AIS008:lab fixture\ncurl | sh\n", "AIS008"), true)
    assert_eq(has_skip("curl | sh\n", "AIS008"), false)
    assert_eq(has_skip("# lacan:skip=AIS008:x\n", "AIS001"), false)
}

test "skip comment python hash" = {
    assert_eq(has_skip("# lacan:skip=AIS008:fp\ncurl | sh\n", "AIS008"), true)
}

test "skip comment rust line" = {
    assert_eq(has_skip("// lacan:skip=AIS008:fp\ncurl | sh\n", "AIS008"), true)
}

test "skip comment typescript block" = {
    assert_eq(has_skip("/* lacan:skip=AIS008:fp */\ncurl | sh\n", "AIS008"), true)
}

test "skip comment bash hash" = {
    assert_eq(has_skip("#!/bin/sh\n# lacan:skip=AIS008:fp\ncurl | sh\n", "AIS008"), true)
}

test "meets_fail_on gate" = {
    f := make_finding("AIS008", Severity.High, "2.1", "AML.T0010.000", "x.sh", 1, "hit")
    assert_eq(meets_fail_on(f, Severity.High), true)
    assert_eq(meets_fail_on(f, Severity.Critical), false)
    assert_eq(meets_fail_on(f, Severity.Low), true)
}

test "experimental rules never fail exit gate" = {
    f := make_finding("AIS208", Severity.Medium, "6.0", "AML.T0010.001", "d.jsonl", 1, "exp")
    assert_eq(is_experimental("AIS208"), true)
    assert_eq(is_experimental("AIS205"), true)
    assert_eq(is_experimental("AIS107"), true)
    assert_eq(is_experimental("AIS008"), false)
    assert_eq(meets_fail_on(f, Severity.Low), true)
    assert_eq(meets_exit_fail_on(f, Severity.Low), false)
    assert_eq(count_exit_failing(singleton_finding(f), Severity.Low), 0)
}

test "count_failing filters by threshold" = {
    lo := make_finding("A", Severity.Low, "t", "x", "a.py", 1, "low")
    hi := make_finding("B", Severity.High, "t", "x", "b.py", 2, "high")
    xs := concat_findings(singleton_finding(lo), singleton_finding(hi))
    assert_eq(len(xs), 2)
    assert_eq(count_failing(xs, Severity.High), 1)
    assert_eq(count_failing(xs, Severity.Low), 2)
}

test "concat_findings preserves both sides" = {
    a := make_finding("A", Severity.Low, "t", "x", "a.py", 1, "a")
    b := make_finding("B", Severity.High, "t", "x", "b.py", 2, "b")
    c := concat_findings(singleton_finding(a), singleton_finding(b))
    assert_eq(len(c), 2)
    assert_eq(c[0].id, "A")
    assert_eq(c[1].id, "B")
}
